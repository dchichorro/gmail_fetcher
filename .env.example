# Gmail API OAuth2 credentials (required)
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Filters config file path (default: ./filters.toml)
# FILTERS_CONFIG=./filters.toml

# Poll interval in seconds (default: 60)
# POLL_INTERVAL=60

# Output directory for attachments (default: ./attachments)
# OUTPUT_DIR=./attachments

# Token file path (default: ./token.json)
# TOKEN_FILE=./token.json

# SQLite database path (default: ./data/gmail_fetcher.db)
# DB_PATH=./data/gmail_fetcher.db

# Log level (default: info)
# RUST_LOG=info
